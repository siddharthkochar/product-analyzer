# n8n Webhook Configuration
# URL to the n8n webhook that processes product images
N8N_WEBHOOK_URL=https://n8n.kochar.dev/webhook/product-analyzer

# Supabase Configuration (PostgreSQL Database)
# Get these from your Supabase project settings at: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Application Configuration
# The public URL where your app will be accessible
NEXT_PUBLIC_APP_URL=https://products.kochar.dev

# Node Environment (production/development)
NODE_ENV=production

# Disable Next.js Telemetry
NEXT_TELEMETRY_DISABLED=1
